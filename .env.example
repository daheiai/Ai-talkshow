# Default OpenAI-compatible endpoint.
# If you use a relay such as One API/New API, set LLM_URL to its base URL.
OPENAI_API_KEY=your_api_key_here
LLM_URL=https://api.openai.com/v1

# Optional: define separate keys/endpoints for specific providers.
# OLD_AI_API_KEY=
# OLD_AI_BASE_URL=
# NEW_AI_API_KEY=
# NEW_AI_BASE_URL=
